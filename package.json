{
  "name": "ponyabc-desktop",
  "version": "0.3.16",
  "description": "PonyABC Desktop companion app (registration, auto pen discovery, two-pane DIY recording manager, BOOK library, firmware)",
  "private": true,
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:mac": "npm run build && npm run pack:mac:arm64 && npm run pack:mac:x64",
    "pack:mac:arm64": "electron-builder --mac --arm64 -c electron-builder.mac-arm64.yml && node scripts/checksum.mjs",
    "pack:mac:x64": "electron-builder --mac --x64 -c electron-builder.mac-x64.yml && node scripts/checksum.mjs",
    "dist:win": "npm run build && electron-builder --win && node scripts/checksum.mjs",
    "dist:win:appx": "npm run build && npm run pack:win:appx",
    "pack:win:appx": "electron-builder --win --config electron-builder.win-appx.yml && node scripts/checksum.mjs"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "i18next": "^24.2.0",
    "iconv-lite": "^0.6.3",
    "mpg123-decoder": "^1.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^5.3.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  }
}
